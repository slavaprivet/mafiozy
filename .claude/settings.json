{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git ls-remote*)",
      "Bash(git rev-list*)",
      "Bash(xxd*)",
      "Bash(tasklist*)",
      "Bash(where.exe*)",
      "Bash(cmdkey /list*)",
      "Bash(printf *)"
    ]
  }
}
