; One combined hiring acceptance fixture, not the original 286-resident world.
config_version=5

[application]
config/name="Мафиози — найм пяти специалистов"
run/main_scene="res://scenes/gang_recruitment.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08,0.11,0.14,1)
