const _walkBlastReceipts=new Set();
let _walkBlastExposureResolver=null;
function _applyWalkLocalBlast19(input={}){
  if(!_walkRendererActive())return {accepted:false,reason:'renderer'};
  if(!_localHostileCanResolveHit())return {accepted:false,reason:'server-owned'};
  const {eventId,kind,r,c,y,sourceVehicleId}=input;
  if(typeof eventId!=='string'||!eventId||eventId.length>160||!['vehicle','c4'].includes(kind)||![r,c].every(Number.isFinite)||(y!==undefined&&!Number.isFinite(y)))return {accepted:false,reason:'invalid'};
  if(_walkBlastReceipts.has(eventId))return {accepted:false,reason:'duplicate'};
  // Source owns power/radius. The renderer supplies physical visibility only.
  const radius=kind==='c4'?4*4.1:10,weapon=kind==='c4'?'c4':'vehicle_explosion';
  const previousContext=_walkShotContext,targets=[],seen=new Set();
  _walkShotContext=null;
  try{
    for(const target of _localBallisticTargets(weapon)){
      if(!target?.key||seen.has(target.key)||target.key.dead||target.key.alive===false)continue;
      seen.add(target.key);
      const distance=Math.hypot(target.r-r,target.c-c)*4.1;
      if(!Number.isFinite(distance)||distance>radius)continue;
      targets.push({...target,id:_threeNpcEntityId(target.key),distance});
    }
  }finally{_walkShotContext=previousContext;}
  const queryTargets=targets.map(target=>({id:target.id,r:target.r,c:target.c,height:1.1}));
  const heroDistance=Math.hypot(player.r-r,player.c-c)*4.1;
  if(!myDead&&heroDistance<=radius&&!input.heroExposure)queryTargets.push({id:'__hero__',r:player.r,c:player.c,height:1.1});
  const exposures=new Map();
  try{
    const result=_walkBlastExposureResolver?.({eventId,kind,r,c,y,sourceVehicleId,targets:queryTargets});
    for(const exposure of (Array.isArray(result?.exposures)?result.exposures:[])){
      if(typeof exposure?.id==='string'&&Number.isFinite(exposure.transmission)&&exposure.transmission>=0&&exposure.transmission<=1)exposures.set(exposure.id,exposure.transmission);
    }
  }catch(error){/* Missing physical LOS must not become a through-wall hit. */}
  // Consume before hit callbacks: explosions can start other explosions.
  _walkBlastReceipts.add(eventId);while(_walkBlastReceipts.size>512)_walkBlastReceipts.delete(_walkBlastReceipts.values().next().value);
  const damageAt=(distance,transmission)=>transmission>0&&distance<=radius?(kind==='c4'?Math.max(1,Math.round(10000*transmission)):distance<radius?Math.max(1,Math.round(70*(1-distance/radius)*transmission)):0):0;
  const hits=[];
  _walkShotContext=null;
  try{
    for(const target of targets){
      const transmission=exposures.get(target.id)||0,damage=damageAt(target.distance,transmission);
      if(!damage)continue;
      const length=Math.hypot(target.r-r,target.c-c),previousRecord=target.key._deathRecord20;
      target.hit(damage,length>.0001?(target.r-r)/length:0,length>.0001?(target.c-c)/length:1);
      if(typeof enrichNpcBlastRecord20==='function'){
        const record=enrichNpcBlastRecord20({entity:target.key,previousRecord,originSource:{r,c}});
        if(record)target.key._deathRecord20=record;
      }
      hits.push({id:target.id,damage,transmission});
    }
  }finally{_walkShotContext=previousContext;}
  const exposure=input.heroExposure,heroDamage=myDead?0:damageAt(exposure?.distance??heroDistance,exposure?.transmission??exposures.get('__hero__')??0),before=myHp;
  if(heroDamage)_hurtLocal(heroDamage,kind==='c4'?'взрыв C4':'взрыв машины',false,{kind:'explosion',weapon,source:{r,c}});
  return {accepted:true,eventId,damage:Math.max(0,before-myHp),npcHits:hits,hp:myHp,dead:myDead};
}
function _applyWalkVehicleBlast(input={}){
  if(!_walkRendererActive())return {accepted:false,reason:'renderer'};
  if(!_localHostileCanResolveHit())return {accepted:false,reason:'server-owned'};
  const {eventId,r,c,distance,transmission}=input;
  const hasHeroExposure=distance!==undefined||transmission!==undefined;
  if(hasHeroExposure&&(![distance,transmission].every(Number.isFinite)||distance<0||transmission<0||transmission>1))return {accepted:false,reason:'invalid'};
  return _applyWalkLocalBlast19({...input,eventId,r,c,kind:'vehicle',heroExposure:hasHeroExposure?{distance,transmission}:null});
}
