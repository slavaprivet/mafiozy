      "vertexPatch": "vec4 interiorMetric=vec4(transformed,1.0);\n   #ifdef USE_BATCHING\n    interiorMetric=batchingMatrix*interiorMetric;\n   #endif\n   #ifdef USE_INSTANCING\n    interiorMetric=instanceMatrix*interiorMetric;\n   #endif\n   vInteriorMetric=(modelMatrix*interiorMetric).xyz;",
      "fragmentPatch": "vec3 interiorNormal=abs(cross(dFdx(vInteriorMetric),dFdy(vInteriorMetric)));\n   vec2 ip=interiorNormal.x>interiorNormal.z?vInteriorMetric.zy:vInteriorMetric.xy;\n   float surfaceTone=1.0;\n   vec2 brick=ip/vec2(.42,.20);brick.x+=mod(floor(brick.y),2.0)*.5;vec2 joint=abs(fract(brick)-.5);float mortar=smoothstep(.455,.48,max(joint.x,joint.y));surfaceTone=mix(.89+sin(floor(brick.x)*3.1+floor(brick.y)*7.3)*.045,1.16,mortar);\n   \n   \n   \n   \n   if(interiorNormal.y>max(interiorNormal.x,interiorNormal.z))surfaceTone=1.0;\n   diffuseColor.rgb*=surfaceTone;",
