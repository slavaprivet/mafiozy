+	if _retired or renderer==null or not is_instance_valid(_host) or not is_instance_valid(_owner): return false
+	var host:RefCounted=_host; var owner:RefCounted=_owner
+	var binding:Dictionary=_binding.duplicate(true)
+	if not host.physical_life_current(_token): return false
+	if _retired or renderer==null or _host!=host or _owner!=owner or _binding!=binding: return false
+	if owner._current(binding).is_empty(): return false
+	return not _retired and renderer!=null and _host==host and _owner==owner and _binding==binding
+
