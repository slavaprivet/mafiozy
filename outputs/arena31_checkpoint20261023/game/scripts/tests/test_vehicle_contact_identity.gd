extends SceneTree
const Identity = preload("res://scripts/vehicle_physics/vehicle_contact_identity.gd")
var checks := 0
var failures: Array[String] = []
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures.append(label)
func _initialize() -> void:
	check(not Identity.describe(null).valid, "missing object rejected")
	var wall := StaticBody3D.new()
	wall.name = "NeverUseNameAsIdentity"
	check(not Identity.describe(wall).valid, "node name cannot invent source identity")
	wall.set_meta("source_id", "building-original-42")
	check(not Identity.describe(wall).valid, "source shape index required")
	wall.set_meta("source_index", 3)
	var row := Identity.describe(wall)
	check(row.valid and row.kind == "static", "actual source wall admitted")
	check(row.source_id == "building-original-42" and row.source_index == 3, "source identity exact")
	check(row.proposal_only and not row.server_admissible, "wall remains proposal only")
	check(row.counterpart_runtime_id == wall.get_instance_id(), "runtime lookup separate")
	wall.set_meta("source_index", -1)
	check(not Identity.describe(wall).valid, "negative index rejected")
	wall.set_meta("source_index", "3")
	check(not Identity.describe(wall).valid, "string index not coerced")
	var car := RigidBody3D.new()
	car.set_meta("vehicle_id", "car-42")
	check(not Identity.describe(car).valid, "vehicle life required")
	car.set_meta("life_generation", 2)
	row = Identity.describe(car)
	check(row.valid and row.life_generation == 2 and row.vehicle_id == "car-42", "vehicle lifetime exact")
	car.set_meta("vehicle_id", " ")
	check(not Identity.describe(car).valid, "empty vehicle rejected")
	var area := Area3D.new()
	area.set_meta("source_id", "area")
	area.set_meta("source_index", 0)
	check(not Identity.describe(area).valid, "sensor cannot become static wall")
	area.set_meta("vehicle_id", "car-42")
	area.set_meta("life_generation", 2)
	check(not Identity.describe(area).valid, "vehicle tags cannot promote sensor into rigid body")
	wall.free()
	car.free()
	area.free()
	print("VEHICLE_CONTACT_IDENTITY ", JSON.stringify({"checks":checks,"failures":failures,"passed":failures.is_empty(),"runtime_wired":false}))
	quit(0 if failures.is_empty() else 1)
