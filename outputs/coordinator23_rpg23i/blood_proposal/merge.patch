+## Final world emission point supplied by the current HP/pose adapter.
+## Reuses the same112-instance pool; never adds a wound or drip attachment.
+func accept_blast(point: Vector3, outward: Vector3, now: float) -> bool:
+	if not is_instance_valid(mesh) or not mesh.is_inside_tree() or not is_instance_valid(_body) or not is_instance_valid(_rig): return false
+	if not point.is_finite() or not outward.is_finite() or outward.length_squared()<.5 or not is_finite(now) or now<0: return false
+	_emit(point,32,outward)
+	return true
+
 func update(delta: float, now: float, ground: float) -> void:
 	if mesh==null or not is_instance_valid(_body) or not is_instance_valid(_rig): return
 	if not is_finite(delta) or not is_finite(now) or not is_finite(ground): clear(); return
