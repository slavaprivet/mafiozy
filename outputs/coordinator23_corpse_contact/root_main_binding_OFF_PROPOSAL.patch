+## Root-owned wiring only. Public owner methods must exist before opt-in.
+func _bind_final_dead_contact_port() -> bool:
+	if preview_population == null or not _player.has_method("set_final_dead_contact_owner"):
+		final_dead_contact_status = "unavailable_player_or_population"; return false
+	for method: String in ["player_final_dead_contact_ready", "admit_player_final_dead_contact"]:
+		if not preview_population.has_method(method):
+			final_dead_contact_status = "public_NPC_port_not_delivered"; return false
+	var bound: bool = _player.set_final_dead_contact_owner(Callable(preview_population,"player_final_dead_contact_ready"), Callable(preview_population,"admit_player_final_dead_contact"))
+	final_dead_contact_status = "bound_waiting_owner_ready" if bound else "binding_failed"
+	return bound
